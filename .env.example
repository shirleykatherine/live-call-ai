# Live Call Co-pilot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# =============================================================================
# LLM Configuration
# =============================================================================
# API key for your LLM provider
# OpenRouter: https://openrouter.ai/keys
# OpenAI: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# API base URL (default: OpenRouter — works with OpenAI too)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model to use. Examples:
#   OpenRouter: openai/gpt-4o-mini, anthropic/claude-3-5-haiku, google/gemini-flash-1.5
#   OpenAI direct: gpt-4o-mini, gpt-4o
LLM_MODEL=openai/gpt-4o-mini

# LLM temperature (0 = deterministic, 1 = creative)
LLM_TEMPERATURE=0.1

# Max tokens per LLM response
LLM_MAX_TOKENS=1024

# =============================================================================
# Embeddings (Local — no API key required)
# =============================================================================
# HuggingFace sentence-transformer model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# Database
# =============================================================================
# SQLite connection string (file-based, no server needed)
DATABASE_URL=sqlite:///./live_call_ai.db

# =============================================================================
# Vector Database (ChromaDB)
# =============================================================================
VECTOR_DB_PATH=./data/chroma_db
VECTOR_DB_COLLECTION=knowledge_base

# =============================================================================
# Speech-to-Text
# =============================================================================
# Provider: "browser" | "deepgram" | "assemblyai"
# "browser" uses the browser's built-in Web Speech API (Chrome only, no key needed)
STT_PROVIDER=browser

# API key — only required if STT_PROVIDER is "deepgram" or "assemblyai"
STT_API_KEY=

# =============================================================================
# App Settings
# =============================================================================
DEBUG=false
